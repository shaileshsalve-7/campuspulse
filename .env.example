# API
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/campuspulse
# Optional alternative for hosted environments: keep the password in its own
# protected variable and place __PASSWORD__ exactly once in the template.
MONGODB_URI_TEMPLATE=
MONGODB_PASSWORD=

# Use long, randomly-generated values outside local development.
JWT_ACCESS_SECRET=replace-with-a-minimum-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-minimum-32-character-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# console writes verification/reset links to the API log for local development.
MAIL_MODE=console
APP_URL=http://localhost:5173
# Required only when MAIL_MODE=smtp. Use credentials supplied by your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=CampusPulse <noreply@example.com>
# Vite reads this value from apps/web/.env in local development. In a hosted web build,
# configure it through the platform instead.
VITE_API_BASE_URL=

# One-time local/controlled-environment bootstrap. Do not commit populated values.
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_ADMIN_FIRST_NAME=Campus
SEED_ADMIN_LAST_NAME=Administrator
