{
  "name": "campuspulse",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@campuspulse/web",
    "dev:web": "npm run dev --workspace=@campuspulse/web",
    "dev:api": "npm run dev --workspace=@campuspulse/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@campuspulse/api"
  },
  "engines": {
    "node": ">=20.11"
  }
}
